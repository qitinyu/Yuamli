# Yuamli 留言系统环境变量配置
# 复制此文件为 .env.local 并填入你的值

# === AUTH_SECRET (必填，用于签名登录态 Cookie) ===
# 任意 16 位以上的随机字符串，可用 `openssl rand -hex 32` 生成
# 更换后所有用户与管理员都需要重新登录
#
# ⚠️ 部署到 Vercel 等 Serverless 平台时这是硬性要求：
#    没配置时进程内会随机生成密钥，每次请求落在不同实例就验签失败，
#    表现为「后台密码能登录成功，但之后所有保存都失败（403）」。
#    请在 Settings → Environment Variables 中为 Production 和 Preview 都配置，然后重新部署。
AUTH_SECRET=请填写随机字符串

# === GitHub OAuth (使用 GitHub 登录时必填) ===
# 1. 前往 https://github.com/settings/developers 创建 OAuth App
# 2. Authorization callback URL 填: http://localhost:3000/api/auth/github/callback
#    (部署后改为: https://你的域名/api/auth/github/callback)
# 3. 将获得的 Client ID 和 Client Secret 填入下方

# 前端使用（公开，会暴露在浏览器中）
NEXT_PUBLIC_GITHUB_CLIENT_ID=你的_GitHub_Client_ID

# 后端使用（保密，不要提交到 Git）
GITHUB_CLIENT_ID=你的_GitHub_Client_ID
GITHUB_CLIENT_SECRET=你的_GitHub_Client_Secret

# === GitCode OAuth (可选) ===
# 前往 https://gitcode.com/oauth/applications 创建应用，回调地址同上格式
# GITCODE_CLIENT_ID=
# GITCODE_CLIENT_SECRET=

# === Vercel KV (部署到 Vercel 时自动配置，无需手动填写) ===
# KV_REST_API_URL=自动注入
# KV_REST_API_TOKEN=自动注入
# KV_REST_API_READ_ONLY_TOKEN=自动注入
